    "@aws-sdk/client-sesv2": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@sentry/react": "^11.6.0",
