# Optional integrations. Cognito/Data/Storage configuration comes from amplify_outputs.json.
VITE_SENTRY_DSN=
# Set explicitly for a proxied prestaging build; Vite's production mode is not the deployment environment.
VITE_SENTRY_ENVIRONMENT=
VITE_GA_MEASUREMENT_ID=
VITE_LOOKER_EMBED_URL=
# Use `shared` for a build served under HARVEST's /feedback path.
# `staging` is the older standalone sign-in mode.
VITE_HARVEST_AUTH_MODE=

# Optional Cognito-only configuration: public pool/client IDs, never secrets.
# Use a browser app client WITHOUT a client secret.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_USER_POOL_CLIENT_ID=

# Backend build environment, dev/test only (not VITE-prefixed):
HARVEST_STAGING_USER_POOL_ID=
HARVEST_STAGING_APP_CLIENT_ID=
HARVEST_API_BASE_URL=
